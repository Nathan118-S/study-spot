{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "streak",
        "test",
        "reminder",
        "info"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "action_label": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}