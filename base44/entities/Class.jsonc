{
  "name": "Class",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "default": "#6366f1"
    },
    "teacher_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "google_classroom"
      ],
      "default": "manual"
    },
    "external_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}