{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "assignment_title": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 0
    },
    "session_type": {
      "type": "string",
      "enum": [
        "focus",
        "break"
      ],
      "default": "focus"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "duration_minutes",
    "session_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}