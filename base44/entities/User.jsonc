{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "totp_secret": {
      "type": "string",
      "description": "TOTP shared secret for two-factor authentication (base32)",
      "default": null
    },
    "twofa_enabled": {
      "type": "boolean",
      "description": "Whether two-factor authentication is enabled for this user",
      "default": false
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}