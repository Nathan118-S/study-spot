{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "totp_secret": {
      "type": "string",
      "description": "TOTP shared secret for two-factor authentication (base32)",
      "default": null
    },
    "twofa_enabled": {
      "type": "boolean",
      "description": "Whether two-factor authentication is enabled for this user",
      "default": false
    },
    "twofa_method": {
      "type": "string",
      "description": "Primary two-factor method used by default at sign-in",
      "enum": [
        "totp",
        "email",
        "passkey"
      ],
      "default": null
    },
    "twofa_methods": {
      "type": "array",
      "description": "All enabled two-factor methods (a user may have several at once)",
      "items": {
        "type": "string",
        "enum": [
          "totp",
          "email",
          "passkey"
        ]
      },
      "default": []
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}