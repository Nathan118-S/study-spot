{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "class_id": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "type": {
      "type": "string",
      "enum": [
        "homework",
        "project",
        "quiz",
        "test",
        "reading",
        "other"
      ],
      "default": "homework"
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "google_calendar",
        "google_classroom",
        "blackboard"
      ],
      "default": "manual"
    },
    "external_id": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "subtasks": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "points": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "score": {
      "type": "number",
      "minimum": 0
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "reminder_sent_hours": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}