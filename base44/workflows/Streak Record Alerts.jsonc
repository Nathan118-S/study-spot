{
  "description": "Pushes a mobile notification when a user sets a new per-class assignment streak record.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "streak_record_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_records": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkStreakRecords",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check streak records",
            "description": "Detect new per-class streak records and push a notification"
          }
        }
      }
    ]
  },
  "name": "Streak Record Alerts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}