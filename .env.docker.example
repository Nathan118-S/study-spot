# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Public address users and the iOS app use (no trailing slash). With the
# https profile this is https://<DOMAIN>.
PUBLIC_URL=https://studyspot.example.com
# Domain for automatic HTTPS (only used with: docker compose --profile https).
DOMAIN=studyspot.example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# Optional: only let Caddy reach the app (recommended with the https profile).
# APP_BIND=127.0.0.1
# APP_PORT=8787

# --- Optional integrations (can also be set later in Admin -> Integration Secrets) ---
# Email: verification codes, password resets, reminders. Without SMTP, emails
# are printed to the logs: docker compose logs -f app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Study Spot <no-reply@example.com>"

# Google sign-in / Calendar / Classroom (redirect URIs use PUBLIC_URL):
#   https://studyspot.example.com/api/auth/google/callback
#   https://studyspot.example.com/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=
GOOGLE_CONNECT_REDIRECT_URI=

# Blackboard Learn: redirect URI is https://studyspot.example.com/blackboard/callback
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=
BLACKBOARD_REDIRECT_URI=

# iOS passkeys: "<TEAM_ID>.<bundle id>", e.g. ABCDE12345.com.yourname.studyspot
IOS_APP_ID=
