<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed for passkeys. Replace the host with your Study Spot server's
	     domain, then set CODE_SIGN_ENTITLEMENTS = StudySpot/StudySpot.entitlements
	     (requires a paid Apple Developer team). See ios/README.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:studyspot.example.com</string>
	</array>
</dict>
</plist>
