<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension so widgets can read the app's data.
	     Must match SharedStore.appGroup in Shared/SharedModels.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.studyspot.app</string>
	</array>
	<!-- Push Notifications capability: without it iOS never gives the app a
	     device token, so reminder pushes and Live Activity pushes can't arrive.
	     Xcode switches this to "production" when archiving for TestFlight and
	     the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
