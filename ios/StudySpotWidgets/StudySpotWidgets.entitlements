<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the widget extension so widgets can read the app's data.
	     Must match SharedStore.appGroup in Shared/SharedModels.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.studyspot.app</string>
	</array>
</dict>
</plist>
