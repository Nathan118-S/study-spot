<?xml version="1.0" encoding="utf-8"?>
<!-- The session token is encrypted with an Android Keystore key that never
     leaves the device, so backing it up would be useless: exclude it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
