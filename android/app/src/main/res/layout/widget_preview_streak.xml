<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for "Streak" (Android 12+). Static sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_streak_label"
        android:textColor="@color/widget_streak"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:text="14"
        android:textColor="@color/widget_text"
        android:textSize="38sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_widget_flame"
        tools:ignore="HardcodedText,UseCompatTextViewDrawableXml" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="AP Calculus"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        tools:ignore="HardcodedText" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="2 active · 1 at risk"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        tools:ignore="HardcodedText" />
</LinearLayout>
