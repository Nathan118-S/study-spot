# Postgres connection
DATABASE_URL=postgres://studyspot:studyspot@localhost:5432/studyspot

# Used to sign auth session tokens (JWT). Generate a long random value.
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts the values pasted into the admin panel's Integration Secrets vault
# (server/src/lib/secrets.js). If unset, SESSION_SECRET is used instead — set
# a separate value here for production so rotating one doesn't affect the
# other. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Base URL the frontend is served from (used for building redirect/callback links and CORS).
FRONTEND_URL=http://localhost:5173

# Port the API server listens on.
PORT=8787

# Outbound email, Google OAuth, and Blackboard OAuth can be configured here
# OR pasted once into the admin panel's Integration Secrets vault (Admin ->
# Integration Secrets) — the vault takes priority when a value is set there.
# Any SMTP provider works (e.g. Postmark, SendGrid SMTP, Gmail with an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Study Spot <no-reply@example.com>"

# Google OAuth (sign-in with Google + Calendar/Classroom sync).
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in the Google Cloud console.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
GOOGLE_CONNECT_REDIRECT_URI=http://localhost:8787/api/connectors/google/callback

# Blackboard Learn OAuth (per-institution "REST API Integration").
# See https://developer.blackboard.com/portal/displayApi
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=
BLACKBOARD_REDIRECT_URI=http://localhost:5173/blackboard/callback
